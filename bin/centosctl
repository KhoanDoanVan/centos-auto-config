#!/usr/bin/env bash

set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<'EOF'
Usage: centosctl COMMAND

Commands:
  inspect      Display system, resource, and network information
  bootstrap    Install and configure the system (requires root)
  verify       Verify the resulting system configuration
  help         Show this help message
EOF
}

command_name="${1:-help}"

case "$command_name" in
    inspect)
        exec "${ROOT_DIR}/scripts/inspect.sh"
        ;;

    bootstrap)
        exec "${ROOT_DIR}/scripts/bootstrap.sh"
        ;;

    verify)
        exec "${ROOT_DIR}/scripts/verify.sh"
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        printf 'Unknown command: %s\n\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac